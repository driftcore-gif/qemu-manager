<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.QEMUManager"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <!-- MainActivity uses NoActionBar theme + custom Toolbar -->
        <activity android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.QEMUManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Other activities use WithBar theme for default action bar -->
        <activity android:name=".ui.VMWizardActivity"
            android:label="New VM"
            android:theme="@style/Theme.QEMUManager.WithBar"
            android:parentActivityName=".ui.MainActivity" />

        <activity android:name=".ui.VMDetailActivity"
            android:label="VM Detail"
            android:theme="@style/Theme.QEMUManager.WithBar"
            android:parentActivityName=".ui.MainActivity" />

        <activity android:name=".ui.VMEditActivity"
            android:label="Edit VM"
            android:theme="@style/Theme.QEMUManager.WithBar"
            android:parentActivityName=".ui.VMDetailActivity" />

        <activity android:name=".ui.QEMUMonitorActivity"
            android:label="QEMU Monitor"
            android:theme="@style/Theme.QEMUManager.WithBar"
            android:parentActivityName=".ui.VMDetailActivity" />

        <activity android:name=".ui.SettingsActivity"
            android:label="Settings"
            android:theme="@style/Theme.QEMUManager.WithBar"
            android:parentActivityName=".ui.MainActivity" />

    </application>
</manifest>
