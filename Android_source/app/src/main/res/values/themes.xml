<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main theme: NoActionBar so MainActivity can use its custom Toolbar -->
    <style name="Theme.QEMUManager" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
    <!-- Theme for activities that want the default action bar from theme -->
    <style name="Theme.QEMUManager.WithBar" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
</resources>
